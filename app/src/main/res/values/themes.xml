<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.EcoLens" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowBackground">@color/bg_light</item>

        <!-- Text & Surface Colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:editTextColor">@color/text_primary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- Progress Bar & Input Controls Tint -->
        <item name="android:indeterminateTint">@color/primary</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="colorControlActivated">@color/primary</item>
        <item name="colorControlNormal">@color/text_secondary</item>

        <!-- Tambahkan baris ini untuk membuat ikon status bar menjadi gelap -->
        <item name="android:windowLightStatusBar">true</item>

        <!-- Opsional: Jika Navigation Bar (tombol back/home di bawah) juga terang -->
        <item name="android:windowLightNavigationBar" tools:targetApi="O_MR1">true</item>
    </style>
    <style name="Theme.BottomNavIndicatorGreen" parent="">
        <!-- Warna kapsul indikator (ganti @color/green dengan warna hijau kodemu) -->
        <item name="colorSecondaryContainer">@color/kid_mint_green_light</item>
    </style>
    <style name="Theme.EcoLens" parent="Base.Theme.EcoLens" />
</resources>